<ui:FluentWindow
    x:Class="AutoMacro.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:AutoMacro.Views"
    mc:Ignorable="d"
    Title="全能脚本V2.3.1"
    Width="1200" Height="750"
    MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    Icon="Assets/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== ROW 0: TITLE BAR ===== -->
        <ui:TitleBar Grid.Row="0" Title="全能脚本精灵" />

        <!-- ===== ROW 1: LEFT NAV + CENTER WORK AREA ===== -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" MaxWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== LEFT PANEL: Project Navigator ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="12,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Profile Selector -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <ui:Button Content="返回首页"
                                   Icon="{ui:SymbolIcon ArrowLeft24}"
                                   Command="{Binding ShowWelcomeCommand}"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,14" />
                        <TextBlock Text="当前方案"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="2,0,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0"
                                      ItemsSource="{Binding Profiles}"
                                      SelectedItem="{Binding SelectedProfile}"
                                      DisplayMemberPath="Name"
                                      Margin="0,0,6,0" />
                            <ui:Button Grid.Column="1"
                                       Icon="{ui:SymbolIcon Add24}"
                                       Command="{Binding NewProfileCommand}"
                                       ToolTip="新建方案"
                                       Appearance="Primary"
                                       Margin="0,0,2,0" />
                            <ui:Button Grid.Column="2"
                                       Icon="{ui:SymbolIcon Rename24}"
                                       Command="{Binding RenameProfileCommand}"
                                       ToolTip="重命名方案"
                                       Margin="0,0,2,0" />
                            <ui:Button Grid.Column="3"
                                       Icon="{ui:SymbolIcon Delete24}"
                                       Command="{Binding DeleteProfileCommand}"
                                       ToolTip="删除方案"
                                       Appearance="Danger" />
                        </Grid>
                        <Border Background="#172B45"
                                BorderBrush="#28598A"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="10,8"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProfileModeText}"
                                           FontWeight="SemiBold"
                                           Foreground="#79B8FF" />
                                <TextBlock Text="{Binding SelectedProfileModeDescription}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="#16231F"
                                BorderBrush="#2C6654"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="11"
                                Margin="0,9,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonitorProfile}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="监控任务步骤" FontWeight="SemiBold" Foreground="#76D8BA" />
                                <TextBlock Text="① 设置目标  →  ② 添加动作  →  ③ 开启监控"
                                           FontSize="11" Margin="0,5,0,8"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding MonitorSettingsSummary}"
                                           FontSize="11" TextWrapping="Wrap"
                                           MaxHeight="46" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:Button Grid.Column="0"
                                               Content="设置目标"
                                               Command="{Binding OpenMonitorSettingsCommand}"
                                               HorizontalAlignment="Stretch" />
                                    <ui:Button Grid.Column="2"
                                               Content="{Binding MonitorButtonText}"
                                               Command="{Binding ToggleMonitoringCommand}"
                                               Appearance="Primary"
                                               HorizontalAlignment="Stretch" />
                                </Grid>
                                <TextBlock Text="{Binding MonitorStatusText}"
                                           FontSize="11" Foreground="#76D8BA"
                                           TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Loop Count (per profile) -->
                    <Grid Grid.Row="1" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="循环次数:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="2,0,8,0" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding LoopCount, Mode=TwoWay}"
                                      Minimum="0"
                                      Maximum="9999"
                                      SpinButtonPlacementMode="Hidden" />
                        <TextBlock Grid.Column="2"
                                   Text="(0=无限)"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <!-- Playback Speed (per profile) -->
                    <Grid Grid.Row="2" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="播放速度:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="2,0,8,0" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding PlaybackSpeed, Mode=TwoWay}"
                                      Minimum="0.1"
                                      Maximum="10"
                                      SpinButtonPlacementMode="Hidden" />
                        <TextBlock Grid.Column="2"
                                   Text="x"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="12"
                                   Margin="6,0,0,0" />
                    </Grid>

                    <!-- Playback Start Step (per profile) -->
                    <Grid Grid.Row="3" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="从第几步:"
                                   VerticalAlignment="Center"
                                   FontSize="13"
                                   Margin="2,0,8,0" />
                        <ui:NumberBox Grid.Column="1"
                                      Value="{Binding PlaybackStartStep, Mode=TwoWay}"
                                      Minimum="1"
                                      Maximum="9999"
                                      SpinButtonPlacementMode="Hidden"
                                      ToolTip="播放时从这个序号对应的步骤开始执行" />
                    </Grid>

                    <!-- Import / Export -->
                    <Grid Grid.Row="4" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Icon="{ui:SymbolIcon ArrowExportUp24}"
                                   Content="导出全局"
                                   Command="{Binding ExportProfileCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,2,0" />
                        <ui:Button Grid.Column="1"
                                   Icon="{ui:SymbolIcon ArrowImport24}"
                                   Content="导入全局"
                                   Command="{Binding ImportProfileCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="2,0,0,0" />
                    </Grid>

                    <Grid Grid.Row="5" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:Button Grid.Column="0"
                                   Icon="{ui:SymbolIcon Settings24}"
                                   Content="快捷键"
                                   Command="{Binding OpenHotkeySettingsCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,0,2,0" />
                        <ui:Button Grid.Column="1"
                                   Content="定时"
                                   Command="{Binding OpenScheduleSettingsCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="2,0,2,0" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="0"
                                   Icon="{ui:SymbolIcon Options24}"
                                   Content="设置"
                                   Click="AppSettings_Click"
                                   HorizontalAlignment="Stretch"
                                   Margin="0,6,2,0" />
                        <ui:Button Grid.Row="1"
                                   Grid.Column="1"
                                   Icon="{ui:SymbolIcon DocumentBulletList24}"
                                   Content="日志"
                                   Command="{Binding OpenLogFolderCommand}"
                                   HorizontalAlignment="Stretch"
                                   Margin="2,6,0,0" />
                        <TextBlock Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ScheduleSummaryText}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="2,8,0,0" />
                    </Grid>

                </Grid>
                </ScrollViewer>
            </Border>

            <!-- GridSplitter -->
            <GridSplitter Grid.Column="1"
                          Width="3"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="Transparent" />

            <!-- ===== CENTER: Action List Editor ===== -->
            <views:ActionListView Grid.Column="2"
                                  DataContext="{Binding ActionListVm}" />
        </Grid>

        <!-- ===== ROW 2: BOTTOM CONTROL & STATUS BAR ===== -->
        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWorkspaceVisible}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Status Indicator -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,10,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#4CAF50" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecording}" Value="True">
                                        <Setter Property="Fill" Value="#F44336" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                        <Setter Property="Fill" Value="#2196F3" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Fill" Value="#55C9A5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               FontSize="13" />
                </StackPanel>

                <!-- Right: Record / Pause / Play / Stop Buttons -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <ui:Button Command="{Binding ToggleRecordingCommand}"
                               Appearance="Danger"
                               Margin="0,0,4,0"
                               MinWidth="100">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RecordButtonText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HotkeyRecordText, StringFormat=' ({0})'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:Button Command="{Binding TogglePauseCommand}"
                               Margin="0,0,4,0"
                               MinWidth="90"
                               Visibility="{Binding ShowPauseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PauseButtonText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HotkeyPauseText, StringFormat=' ({0})'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:Button Command="{Binding TogglePlaybackCommand}"
                               Appearance="Primary"
                               Margin="0,0,4,0"
                               MinWidth="100">
                        <ui:Button.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding PlaybackButtonText}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding HotkeyPlaybackText, StringFormat=' ({0})'}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:Button Content="紧急停止"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Command="{Binding EmergencyStopCommand}"
                               Appearance="Caution"
                               ToolTip="{Binding HotkeyStopText, StringFormat='快捷键: {0}'}"
                               MinWidth="80" />
                    <ui:Button Icon="{ui:SymbolIcon ArrowMinimize24}"
                               Content="迷你"
                               Click="MiniMode_Click"
                               ToolTip="切换迷你模式"
                               Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BEGINNER HOME: CHOOSE HOW THE TASK STARTS ===== -->
        <Grid Grid.Row="1" Grid.RowSpan="2" Background="#171717">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWelcomeVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid MaxWidth="1120" Margin="44,28,44,30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="68" Height="68"
                                Background="#1E6FD9"
                                CornerRadius="14"
                                VerticalAlignment="Center">
                            <Image Source="Assets/icon.ico"
                                   Width="46" Height="46"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="欢迎使用"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="全能脚本精灵"
                                       FontSize="30"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                    </Grid>

                    <Separator Grid.Row="1" Margin="0,0,0,34" />

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                        <TextBlock Text="你希望脚本怎么工作？"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="先选择一种方式，后续步骤会一步一步带你完成"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <Grid Grid.Row="3" Margin="70,36,70,34">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#202020"
                                BorderBrush="#3B3B3B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="28">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58"
                                            HorizontalAlignment="Left"
                                            Background="#182A43"
                                            CornerRadius="10">
                                        <ui:SymbolIcon Symbol="DocumentBulletList24"
                                                       FontSize="30"
                                                       Foreground="#4DA3FF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="普通脚本"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="需要时由我启动"
                                                   FontSize="13"
                                                   Foreground="#8CC5FF"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="适合手动点击、快捷键或定时执行。先录制操作，再按需要启动。"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="23"
                                           Margin="0,22,0,24" />
                                <ui:Button Grid.Row="2"
                                           Content="创建普通脚本"
                                           Command="{Binding CreateStandardProfileCommand}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           FontSize="15"
                                           Padding="16,10" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#202020"
                                BorderBrush="#3B3B3B"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="28">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58"
                                            HorizontalAlignment="Left"
                                            Background="#15342F"
                                            CornerRadius="10">
                                        <ui:SymbolIcon Symbol="Options24"
                                                       FontSize="30"
                                                       Foreground="#55C9A5" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="监控任务"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="看到目标后自动启动"
                                                   FontSize="13"
                                                   Foreground="#76D8BA"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Grid.Row="1"
                                           Text="适合等待指定图片、文字或窗口出现，然后自动执行整套操作。"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           LineHeight="23"
                                           Margin="0,22,0,24" />
                                <ui:Button Grid.Row="2"
                                           Content="创建监控任务"
                                           Command="{Binding CreateMonitorProfileCommand}"
                                           Appearance="Primary"
                                           HorizontalAlignment="Stretch"
                                           FontSize="15"
                                           Padding="16,10" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid HorizontalAlignment="Center" Margin="0,0,0,30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19"
                                        BorderBrush="#2D8CFF" BorderThickness="2">
                                    <TextBlock Text="1" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                               Foreground="#66AFFF" />
                                </Border>
                                <TextBlock Text="选择启动方式" Margin="0,8,0,0" />
                            </StackPanel>
                            <Separator Grid.Column="1" VerticalAlignment="Center" Margin="12,0" />
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19"
                                        BorderBrush="#666666" BorderThickness="2">
                                    <TextBlock Text="2" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="设置执行动作" Margin="0,8,0,0" />
                            </StackPanel>
                            <Separator Grid.Column="3" VerticalAlignment="Center" Margin="12,0" />
                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="19"
                                        BorderBrush="#666666" BorderThickness="2">
                                    <TextBlock Text="3" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="测试并启用" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                            <ui:Button Content="打开已有任务"
                                       Icon="{ui:SymbolIcon DocumentBulletList24}"
                                       Command="{Binding OpenWorkspaceCommand}"
                                       Margin="0,0,8,0" />
                            <ui:Button Content="导入配置"
                                       Icon="{ui:SymbolIcon ArrowImport24}"
                                       Command="{Binding ImportProfileCommand}" />
                            <TextBlock Text="{Binding Profiles.Count, StringFormat='已有 {0} 个任务'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="18,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
