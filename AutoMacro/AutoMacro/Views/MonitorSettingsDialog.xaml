<ui:FluentWindow
    x:Class="AutoMacro.Views.MonitorSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="设置监控任务"
    Width="860" Height="680"
    MinWidth="760" MinHeight="600"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    Icon="/Assets/icon.ico">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="设置监控任务" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,22,34,24">
                <TextBlock Text="让软件在看到目标后自动执行脚本"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="按照下面三步完成设置。普通用户只需要填写目标，其他参数可以保持默认。"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="0,8,0,24" />

                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="#2583E8">
                            <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="选择监控类型" FontWeight="SemiBold" />
                            <TextBlock Text="图片、文字或窗口" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#666" BorderThickness="1">
                            <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="指定监控目标" FontWeight="SemiBold" />
                            <TextBlock Text="选择内容和区域" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" BorderBrush="#666" BorderThickness="1">
                            <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="SemiBold" />
                        </Border>
                        <StackPanel Margin="10,0,0,0">
                            <TextBlock Text="测试并保存" FontWeight="SemiBold" />
                            <TextBlock Text="确认当前能够识别" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="第一步：要监控什么？" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="选择一种触发条件"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,12" />
                        <ComboBox x:Name="TriggerTypeBox"
                                  SelectionChanged="TriggerTypeBox_SelectionChanged"
                                  FontSize="14">
                            <ComboBoxItem Content="图片出现" Tag="Image" />
                            <ComboBoxItem Content="文字出现" Tag="Text" />
                            <ComboBoxItem Content="窗口出现" Tag="Window" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="第二步：告诉软件目标是什么" FontSize="17" FontWeight="SemiBold" />

                        <Grid x:Name="ImageTargetPanel" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="140" Height="96" Background="#151515"
                                    BorderBrush="#454545" BorderThickness="1" CornerRadius="6">
                                <Grid>
                                    <Image x:Name="TargetPreview" Stretch="Uniform" Margin="6" />
                                    <TextBlock x:Name="PreviewPlaceholder"
                                               Text="尚未选择图片"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <TextBlock Text="目标图片" FontWeight="SemiBold" />
                                <TextBlock x:Name="ImagePathText" Text="尚未选择"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,5,0,12" />
                                <StackPanel Orientation="Horizontal">
                                    <ui:Button Content="框选画面作为目标"
                                               Appearance="Primary"
                                               Click="CaptureTarget_Click"
                                               Margin="0,0,8,0" />
                                    <ui:Button Content="从文件选择"
                                               Click="SelectImage_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="TextTargetPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="出现什么文字时触发？" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ui:TextBox x:Name="TargetTextBox"
                                        PlaceholderText="例如：提交成功、立即支付、下载完成" />
                        </StackPanel>

                        <StackPanel x:Name="WindowTargetPanel" Margin="0,16,0,0" Visibility="Collapsed">
                            <TextBlock Text="窗口标题包含什么文字时触发？" FontWeight="SemiBold" Margin="0,0,0,7" />
                            <ui:TextBox x:Name="WindowTitleBox"
                                        PlaceholderText="例如：微信、订单管理、导出完成" />
                        </StackPanel>

                        <Grid x:Name="RegionPanel" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="监控范围" FontWeight="SemiBold" />
                                <TextBlock x:Name="RegionSummaryText" Text="整个屏幕"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="框选监控区域"
                                           Click="SelectRegion_Click"
                                           Margin="0,0,8,0" />
                                <ui:Button Content="恢复全屏"
                                           Click="ClearRegion_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="22">
                    <StackPanel>
                        <TextBlock Text="第三步：测试后保存" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="测试只识别一次，不会执行脚本。"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,14" />

                        <Expander Header="高级设置（通常不需要修改）" Margin="0,0,0,14">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="扫描间隔（毫秒）" Margin="0,0,0,5" />
                                    <ui:NumberBox x:Name="ScanIntervalBox" Minimum="300" Maximum="5000"
                                                  SmallChange="100" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="连续识别次数" Margin="0,0,0,5" />
                                    <ui:NumberBox x:Name="ConsecutiveMatchesBox" Minimum="1" Maximum="5" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,14,0,0">
                                    <TextBlock Text="图片匹配度（0.50～1.00）" Margin="0,0,0,5" />
                                    <ui:NumberBox x:Name="ThresholdBox" Minimum="0.5" Maximum="1"
                                                  SmallChange="0.01" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,14,0,0">
                                    <TextBlock Text="触发冷却（秒）" Margin="0,0,0,5" />
                                    <ui:NumberBox x:Name="CooldownBox" Minimum="0" Maximum="3600" />
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Border x:Name="TestResultBorder"
                                Background="#172B45" BorderBrush="#28598A"
                                BorderThickness="1" CornerRadius="6" Padding="12"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TestResultText" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <ui:Button x:Name="TestButton"
                           Content="测试识别"
                           Click="Test_Click"
                           HorizontalAlignment="Left"
                           MinWidth="100" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="取消" Click="Cancel_Click" Margin="0,0,8,0" MinWidth="88" />
                    <ui:Button Content="保存设置" Click="Save_Click"
                               Appearance="Primary" MinWidth="110" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
